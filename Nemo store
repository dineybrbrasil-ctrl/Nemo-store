local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local ADMINS = {
[7395796140] = true,
}
local remote = ReplicatedStorage:FindFirstChild("BrasilMenuAction")
if not remote then
remote = Instance.new("RemoteEvent")
remote.Name = "BrasilMenuAction"
remote.Parent = ReplicatedStorage
end
local states = {}
local function isAdmin(player)
return ADMINS[player.UserId] == true
end
local function notify(player, message)
remote:FireClient(player, "Notice", message)
end
local function getHumanoid(player)
local character = player.Character
return character and character:FindFirstChildOfClass("Humanoid")
end
local function getRoot(player)
local character = player.Character
return character and character:FindFirstChild("HumanoidRootPart")
end
local function setNoclip(player, enabled)
local character = player.Character
if not character then return end
states[player] = states[player] or {}
states[player].noclip = enabled
for _, obj in ipairs(character:GetDescendants()) do
if obj:IsA("BasePart") then
if enabled then
if obj:GetAttribute("BrasilOriginalCanCollide") == nil then
obj:SetAttribute("BrasilOriginalCanCollide", obj.CanCollide)
end
obj.CanCollide = false
else
local original = obj:GetAttribute("BrasilOriginalCanCollide")
if original ~= nil then
obj.CanCollide = original
obj:SetAttribute("BrasilOriginalCanCollide", nil)
end
end
end
end
end
local function setFly(player, enabled)
local root = getRoot(player)
if not root then return end
states[player] = states[player] or {}
states[player].fly = enabled
if enabled then
local attachment = root:FindFirstChild("BrasilFlyAttachment") or Instance.new("Attachment")
attachment.Name = "BrasilFlyAttachment"
attachment.Parent = root
local velocity = root:FindFirstChild("BrasilFlyVelocity") or Instance.new("LinearVelocity")
velocity.Name = "BrasilFlyVelocity"
velocity.Attachment0 = attachment
velocity.RelativeTo = Enum.ActuatorRelativeTo.World
velocity.VectorVelocity = Vector3.new(0, 22, 0)
velocity.MaxForce = 100000
velocity.Parent = root
else
local v = root:FindFirstChild("BrasilFlyVelocity")
if v then v:Destroy() end
local a = root:FindFirstChild("BrasilFlyAttachment")
if a then a:Destroy() end
end
end
local function teleportNamed(player, name)
local root = getRoot(player)
if not root then return end
local target = workspace:FindFirstChild(name, true)
if target then
local cf
if target:IsA("BasePart") then
cf = target.CFrame
elseif target:IsA("Model") then
cf = target:GetPivot()
end
if cf then
root.CFrame = cf + Vector3.new(0, 4, 0)
return
end
end
notify(player, "Não encontrei '" .. name .. "'. Crie uma peça ou modelo com esse nome no Workspace.")
end
remote.OnServerEvent:Connect(function(player, action, value)
if not isAdmin(player) then
notify(player, "Acesso negado: seu UserId não está na lista de administradores.")
return
end
local humanoid = getHumanoid(player)
if action == "Speed" then
if humanoid and typeof(value) == "number" then
humanoid.WalkSpeed = math.clamp(value, 16, 100)
end
elseif action == "Jump" then
if humanoid and typeof(value) == "number" then
humanoid.UseJumpPower = true
humanoid.JumpPower = math.clamp(value, 50, 150)
end
elseif action == "Reset" then
if player.Character then player.Character:BreakJoints() end
elseif action == "Coordinates" then
local root = getRoot(player)
if root then
remote:FireClient(player, "Coordinates", string.format("X %.1f | Y %.1f | Z %.1f", root.Position.X, root.Position.Y, root.Position.Z))
end
elseif action == "Fly" then
local enabled = not (states[player] and states[player].fly)
setFly(player, enabled)
notify(player, "Voo de teste: " .. (enabled and "ligado" or "desligado"))
elseif action == "Noclip" then
local enabled = not (states[player] and states[player].noclip)
setNoclip(player, enabled)
notify(player, "Noclip de teste: " .. (enabled and "ligado" or "desligado"))
elseif action == "HighlightNPCs" then
local count = 0
for _, obj in ipairs(CollectionService:GetTagged("TrainingTarget")) do
if obj:IsA("Model") or obj:IsA("BasePart") then
local h = obj:FindFirstChildOfClass("Highlight")
if not h then
h = Instance.new("Highlight")
h.Name = "BrasilTrainingHighlight"
h.FillColor = Color3.fromRGB(0, 200, 255)
h.OutlineColor = Color3.new(1,1,1)
h.Parent = obj
end
count += 1
end
end
notify(player, "NPCs/objetos de treino destacados: " .. count .. ". Use a tag TrainingTarget.")
elseif action == "TeleportSpawn" then
teleportNamed(player, "Spawn")
elseif action == "TeleportLobby" then
teleportNamed(player, "Lobby")
elseif action == "Close" then
remote:FireClient(player, "Close")
else
notify(player, "Ação desconhecida.")
end
end)
Players.PlayerRemoving:Connect(function(player)
states[player] = nil
end)
Players.PlayerAdded:Connect(function(player)
player.CharacterAdded:Connect(function()
task.wait(1)
local st = states[player]
if st and st.noclip then setNoclip(player, true) end
if st and st.fly then setFly(player, true) end
end)
end)
