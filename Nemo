# -- NEMO PANEL | Mobile-stability revision (Roblox Studio LocalScript)
-- Intended for a Roblox experience you own/control; not an executor bypass.
-- A client script cannot grant server-side admin permissions.
-- Training highlights are limited to models tagged "TrainingTarget".

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local player = Players.LocalPlayer
if not player then return end

-- Avoid duplicate interfaces when the LocalScript is started again.
local playerGui = player:WaitForChild("PlayerGui")
local previousGui = playerGui:FindFirstChild("NemoPanel")
if previousGui then previousGui:Destroy() end

local purple = Color3.fromRGB(164, 45, 255)
local bg = Color3.fromRGB(17, 17, 20)
local panel = Color3.fromRGB(27, 27, 31)
local white = Color3.fromRGB(242, 242, 247)
local muted = Color3.fromRGB(155, 155, 165)
local green = Color3.fromRGB(55, 220, 115)

local settings = {
    ShowFOV = false, ESP = false, ShowCoords = true,
    Speed = 16, Jump = 50, FOV = 70, MaxDistance = 200,
    TriggerDelay = 50, RCS = 50,
}
local currentTab = "Aim"
local espObjects = {}
local gui, main, content, sidebar
local renderTab

local function notify(message)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Nemo Panel", Text = tostring(message), Duration = 3
        })
    end)
end

local function getParts()
    local char = player.Character
    return char, char and char:FindFirstChildOfClass("Humanoid"),
        char and char:FindFirstChild("HumanoidRootPart")
end

local function clearESP()
    for _, obj in ipairs(espObjects) do
        if obj then pcall(function() obj:Destroy() end) end
    end
    table.clear(espObjects)
end

local function refreshESP()
    clearESP()
    if not settings.ESP then return end
    local _, _, root = getParts()
    if not root then return end
    for _, model in ipairs(CollectionService:GetTagged("TrainingTarget")) do
        if model:IsA("Model") and model ~= player.Character then
            local targetRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
            if targetRoot and (targetRoot.Position - root.Position).Magnitude <= settings.MaxDistance then
                local highlight = Instance.new("Highlight")
                highlight.Name = "NemoTrainingHighlight"
                highlight.Adornee = model
                highlight.FillColor = green
                highlight.OutlineColor = purple
                highlight.FillTransparency = 0.65
                highlight.Parent = model
                table.insert(espObjects, highlight)

                local bb = Instance.new("BillboardGui")
                bb.Name = "NemoTrainingLabel"
                bb.Adornee = targetRoot
                bb.Size = UDim2.fromOffset(180, 30)
                bb.StudsOffset = Vector3.new(0, 3, 0)
                bb.AlwaysOnTop = true
                bb.Parent = gui
                table.insert(espObjects, bb)

                local label = Instance.new("TextLabel")
                label.Size = UDim2.fromScale(1, 1)
                label.BackgroundTransparency = 1
                label.TextColor3 = white
                label.TextStrokeTransparency = 0.2
                label.Font = Enum.Font.GothamBold
                label.TextSize = 13
                label.Parent = bb
                label.Text = model.Name .. " • " ..
                    math.floor((targetRoot.Position - root.Position).Magnitude) .. " studs"
            end
        end
    end
end

gui = Instance.new("ScreenGui")
gui.Name = "NemoPanel"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.Parent = playerGui

