-- Drag by header; works with touch and mouse.
do
    local dragging, startInput, startPos
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging, startInput, startPos = true, input.Position, main.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - startInput
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

local navButtons = {}
local function clearContent()
    for _, child in ipairs(content:GetChildren()) do
        if child ~= layout and child ~= pad then child:Destroy() end
    end
end

local function section(text)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -2, 0, 32)
    frame.BackgroundColor3 = panel
    frame.BorderSizePixel = 0
    frame.Parent = content
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 9, 0, 0)
    label.Size = UDim2.new(1, -18, 1, 0)
    label.Text = "✦  " .. text
    label.TextColor3 = white
    label.TextSize = 13
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
end

local function button(text, callback, active)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -2, 0, 36)
    b.BackgroundColor3 = active and Color3.fromRGB(65, 28, 92) or panel
    b.BorderSizePixel = 0
    b.Text = text
    b.TextColor3 = white
    b.TextSize = 12
    b.TextWrapped = true
    b.Font = Enum.Font.Gotham
    b.Parent = content
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.Activated:Connect(callback)
    return b
end

local function toggle(text, key, callback)
    local b
    local function update()
        b.Text = (settings[key] and "☑  " or "□  ") .. text
        b.BackgroundColor3 = settings[key] and Color3.fromRGB(65, 28, 92) or panel
    end
    b = button("", function()
        settings[key] = not settings[key]
        update()
        if callback then callback(settings[key]) end
    end)
    update()
end

local function valueControl(text, key, minimum, maximum, step, suffix, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -2, 0, 40)
    row.BackgroundColor3 = panel
    row.BorderSizePixel = 0
    row.Parent = content
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 8, 0, 0)
    label.Size = UDim2.new(1, -88, 1, 0)
    label.TextColor3 = white
    label.TextSize = 11
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local function update()
        label.Text = text .. ": " .. tostring(settings[key]) .. suffix
    end
    local minus = Instance.new("TextButton")
    minus.Size = UDim2.fromOffset(26, 28)
    minus.Position = UDim2.new(1, -59, 0.5, -14)
    minus.BackgroundColor3 = Color3.fromRGB(56, 34, 70)
    minus.Text = "−"
    minus.TextColor3 = white
    minus.TextSize = 17
    minus.Parent = row
    Instance.new("UICorner", minus).CornerRadius = UDim.new(0, 5)
    local plus = Instance.new("TextButton")
    plus.Size = UDim2.fromOffset(26, 28)
    plus.Position = UDim2.new(1, -29, 0.5, -14)
    plus.BackgroundColor3 = purple
    plus.Text = "+"
    plus.TextColor3 = white
    plus.TextSize = 17
    plus.Parent = row
    Instance.new("UICorner", plus).CornerRadius = UDim.new(0, 5)

    minus.Activated:Connect(function()
        settings[key] = math.clamp(settings[key] - step, minimum, maximum)
        update()
        if callback then callback(settings[key]) end
    end)
    plus.Activated:Connect(function()
        settings[key] = math.clamp(settings[key] + step, minimum, maximum)
        update()
        if callback then callback(settings[key]) end
    end)
    update()
end

local function applyMovement()
    local _, hum = getParts()
    if hum then
        hum.WalkSpeed = settings.Speed
        hum.UseJumpPower = true
        hum.JumpPower = settings.Jump
    else
        notify("Seu personagem ainda não carregou.")
    end
end

local function updateFOV(value)
    local cam = workspace.CurrentCamera
    if cam then cam.FieldOfView = value end
end

renderTab = function(tab)
    currentTab = tab
    clearContent()
    for name, b in pairs(navButtons) do
        b.BackgroundColor3 = name == tab and Color3.fromRGB(65, 28, 92) or Color3.fromRGB(13, 13, 16)
        b.TextColor3 = name == tab and white or muted
    end

    if tab == "Aim" then
        section("AIM SETTINGS")
        toggle("Mostrar FOV visual", "ShowFOV", function(v)
            notify(v and "FOV visual ligado." or "FOV visual desligado.")
        end)
        valueControl("Campo de visão da câmera", "FOV", 40, 100, 5, "°", updateFOV)
        section("TRAINING")
        button("Centralizar câmera no personagem", function()
            local _, _, root = getParts()
            local cam = workspace.CurrentCamera
            if root and cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, root.Position) end
        end)
        button("Mira automática não incluída; ferramentas de treino apenas.", function() end)
    elseif tab == "Trigger" then
        section("TRIGGER TRAINING")
        valueControl("Delay de treino", "TriggerDelay", 0, 500, 25, " ms", nil)
        button("Detectar alvo de treino próximo", function()
            local _, _, root = getParts()
            if not root then return end
            local nearest, dist
            for _, model in ipairs(CollectionService:GetTagged("TrainingTarget")) do
                local targetRoot = model:IsA("Model") and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)
                if targetRoot then
                    local d = (targetRoot.Position - root.Position).Magnitude
                    if not dist or d < dist then nearest, dist = model, d end
                end
            end
            if nearest then notify("Alvo: " .. nearest.Name .. " • " .. math.floor(dist) .. " studs")
            else notify("Nenhum TrainingTarget encontrado.") end
        end, true)
        valueControl("Intensidade visual RCS", "RCS", 0, 100, 10, "%", nil)
    elseif tab == "ESP" then
        section("ESP • TRAINING TARGETS")
        toggle("Destacar NPCs marcados", "ESP", refreshESP)
        button("Atualizar destaques", refreshESP)
        valueControl("Distância máxima", "MaxDistance", 25, 1000, 25, " studs", refreshESP)
        button("Use a tag TrainingTarget nos NPCs do seu jogo.", function()
            notify("No Studio, adicione a tag TrainingTarget ao modelo do NPC.")
        end)
    elseif tab == "Radar" then
        section("LOCAL RADAR")
        toggle("Mostrar coordenadas", "ShowCoords", nil)
        valueControl("Alcance de detecção", "MaxDistance", 25, 1000, 25, " studs", refreshESP)
        local _, _, root = getParts()
        if root and settings.ShowCoords then
            local p = root.Position
            button(string.format("X %.1f   Y %.1f   Z %.1f", p.X, p.Y, p.Z), function()
                notify(string.format("X %.1f / Y %.1f / Z %.1f", p.X, p.Y, p.Z))
            end)
        end
        button("Atualizar coordenadas", function() renderTab("Radar") end)
    elseif tab == "Misc" then
        section("MOVEMENT")
        valueControl("Velocidade", "Speed", 0, 100, 4, "", applyMovement)
        valueControl("Força do pulo", "Jump", 0, 150, 5, "", applyMovement)
        button("Restaurar velocidade e pulo padrão", function()
            settings.Speed, settings.Jump = 16, 50
            applyMovement()
            renderTab("Misc")
        end)
        button("Resetar personagem local", function()
            local _, hum = getParts()
            if hum then hum.Health = 0 end
        end)
        section("MENU")
        button("Fechar painel", function() main.Visible = false end)
    elseif tab == "Players" then
        section("PLAYER LIST")
        button("A lista administrativa real precisa de RemoteFunction no servidor.", function()
            notify("Um script de cliente isolado não pode autorizar ações de servidor.")
        end)
        button("Trazer/teleportar/congelar outros jogadores requer integração com seu servidor.", function()
            notify("Adicione RemoteFunctions e valide UserIds de admins no servidor do seu jogo.")
        end)
    end
end

for i, info in ipairs({
    {"Aim", "◎"}, {"Trigger", "ϟ"}, {"ESP", "◉"},
    {"Radar", "◧"}, {"Players", "♙"}, {"Misc", "⚙"},
}) do
    local name, symbol = info[1], info[2]
    local b = Instance.new("TextButton")
    b.LayoutOrder = i
    b.Size = UDim2.new(1, 0, 0, 43)
    b.BackgroundColor3 = Color3.fromRGB(13, 13, 16)
    b.BorderSizePixel = 0
    b.Text = symbol .. "\n" .. name
    b.TextColor3 = muted
    b.TextSize = 11
    b.Font = Enum.Font.Gotham
    b.Parent = sidebar
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.Activated:Connect(function() renderTab(name) end)
    navButtons[name] = b
end

player.CharacterAdded:Connect(function()
    task.wait(0.5)
    applyMovement()
    if settings.ESP then refreshESP() end
end)

-- Refresh labels at a modest interval instead of every frame to reduce mobile load.
local espUpdateElapsed = 0
RunService.Heartbeat:Connect(function(dt)
    if not settings.ESP then return end
    espUpdateElapsed += dt
    if espUpdateElapsed < 0.25 then return end
    espUpdateElapsed = 0

    local _, _, root = getParts()
    if not root then return end
    for i = #espObjects, 1, -1 do
        local obj = espObjects[i]
        if not obj or not obj.Parent then
            table.remove(espObjects, i)
        elseif obj:IsA("BillboardGui") and obj.Adornee and obj.Adornee.Parent then
            local label = obj:FindFirstChildOfClass("TextLabel")
            if label then
                label.Text = obj.Adornee.Parent.Name .. " • " ..
                    math.floor((obj.Adornee.Position - root.Position).Magnitude) .. " studs"
            end
        end
    end
end)

